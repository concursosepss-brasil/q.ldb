      <button class="secondary" onclick="init()">Voltar</button>
    </div>`;
  document.getElementById('infoLeft').textContent = 'Área do administrador';
  document.getElementById('infoRight').textContent = '';
}

async function adminLogin() {
  const email = document.getElementById('adminEmail').value.trim();
  const pass = document.getElementById('adminPass').value;
  const errorEl = document.getElementById('adminError');
  try {
    await auth.signInWithEmailAndPassword(email, pass);
    errorEl.classList.remove('show');
    renderAdminPanel();
  } catch (e) {
    errorEl.classList.add('show');
  }
}

async function renderAdminPanel() {
  renderLoading('Carregando solicitações…');
  document.getElementById('infoLeft').textContent = 'Área do administrador';

  let all = [];
  try {
    const snap = await db.collection(REQUESTS_COLLECTION).get();
    snap.forEach(doc => all.push(doc.data()));
  } catch (e) {
    renderGateError('Não foi possível carregar as solicitações. Verifique sua conexão e as regras do Firestore.');
    return;
  }

  const pending = all.filter(r => r.status === 'pending');
  const approved = all.filter(r => r.status === 'approved');

  let pendingRows = pending.map(r => `
    <tr>
      <td>${r.email}</td>
      <td class="admin-actions">
        <button class="success" onclick="approveEmail('${r.email}')">Aprovar</button>
        <button class="secondary" onclick="rejectEmail('${r.email}')">Recusar</button>
      </td>
    </tr>`).join('');
  if (!pending.length) pendingRows = `<tr><td colspan="2" class="admin-empty">Nenhuma solicitação pendente.</td></tr>`;

  let approvedRows = approved.map(r => `
    <tr>
      <td>${r.email}</td>
      <td class="admin-actions">
        <button class="secondary" onclick="revokeEmail('${r.email}')">Revogar acesso</button>
      </td>
    </tr>`).join('');
  if (!approved.length) approvedRows = `<tr><td colspan="2" class="admin-empty">Nenhum e-mail aprovado ainda.</td></tr>`;

  document.getElementById('main').innerHTML = `
    <div class="gate-screen" style="text-align:left; max-width:700px; margin:0 auto;">
      <h2 style="text-align:center;">Painel do administrador</h2>
      <h3 style="color:#0d2a52; margin:22px 0 8px;">Solicitações pendentes</h3>
      <table class="admin-table">
        <thead><tr><th>E-mail</th><th>Ação</th></tr></thead>
        <tbody>${pendingRows}</tbody>
      </table>
      <h3 style="color:#0d2a52; margin:22px 0 8px;">Acessos aprovados</h3>
      <table class="admin-table">
        <thead><tr><th>E-mail</th><th>Ação</th></tr></thead>
        <tbody>${approvedRows}</tbody>
      </table>
      <div style="text-align:center; margin-top:20px;">
        <button class="secondary" onclick="init()">Voltar ao simulado</button>
        <button class="secondary" onclick="adminLogout()">Sair da conta</button>
      </div>
    </div>`;
  document.getElementById('infoRight').textContent = `${pending.length} pendente(s) • ${approved.length} aprovado(s)`;
}

async function adminLogout() {
  await auth.signOut();
  init();
}

async function approveEmail(email) {
  await db.collection(REQUESTS_COLLECTION).doc(email).update({ status: 'approved' });
  renderAdminPanel();
}

async function rejectEmail(email) {
  await db.collection(REQUESTS_COLLECTION).doc(email).update({ status: 'rejected' });
  renderAdminPanel();
}

async function revokeEmail(email) {
  await db.collection(REQUESTS_COLLECTION).doc(email).update({ status: 'pending' });
  renderAdminPanel();
}

/* ===================== TELA INICIAL DO SIMULADO ===================== */

function renderStart() {
  document.getElementById('main').innerHTML = `
    <div class="start-screen">
      <h2>Bem-vindo(a) ao Simulado!</h2>
      <p>Teste seus conhecimentos com <strong>58 questões contextualizadas</strong>, voltadas para concursos públicos com foco na LDB (Lei 9.394/1996).</p>
      <ul>
        <li>📖 <strong>Textos de apoio detalhados</strong> (leis, teorias e situações-problema)</li>
        <li>🎯 Questões de múltipla escolha (A a E)</li>
        <li>💡 Feedback explicativo ao final de cada questão</li>
        <li>📊 Resultado final com revisão detalhada de todas as questões</li>
      </ul>
      <button class="success" onclick="startQuiz()" style="margin-top:20px; padding:14px 32px; font-size:1.1rem;">Iniciar Simulado</button>
    </div>`;
  document.getElementById('progressBar').style.width = '0%';
  document.getElementById('infoLeft').textContent = 'Aguardando início';
  document.getElementById('infoRight').textContent = '58 questões';
}

function startQuiz() {
  current = 0;
  answers = new Array(Q.length).fill(null);
  renderQuestion();
}

function renderQuestion() {
  const q = Q[current];
  const total = Q.length;
  const answered = answers.filter(a => a !== null).length;
  const correct = answers.filter((a, i) => a === Q[i].a).length;

  document.getElementById('progressBar').style.width = ((current + 1) / total * 100) + '%';
  document.getElementById('infoLeft').textContent = `Questão ${current + 1} de ${total}`;
  document.getElementById('infoRight').textContent = `Acertos: ${correct} | Respondidas: ${answered}`;

  let optionsHtml = '';
  q.o.forEach((opt, i) => {
    const letter = String.fromCharCode(65 + i);
    const checked = answers[current] === i ? 'checked' : '';
    const selectedClass = answers[current] === i ? 'selected' : '';
    optionsHtml += `<li class="${selectedClass}" onclick="selectOption(${i})">
      <input type="radio" name="q${current}" id="opt${i}" ${checked}>
      <label for="opt${i}"><strong>${letter})</strong> ${opt}</label>
    </li>`;
  });

  document.getElementById('main').innerHTML = `
    <div class="question-card active">
      <span class="q-number">Questão ${current + 1}</span>
      <div class="q-context">${q.c}</div>
      <div class="q-text">${q.t}</div>
      <ul class="options">${optionsHtml}</ul>
      <div class="nav-buttons">
        <button class="secondary" onclick="prevQuestion()" ${current === 0 ? 'disabled' : ''}>← Anterior</button>
        <button onclick="confirmAnswer()" ${answers[current] === null ? 'disabled' : ''}>Confirmar Resposta</button>
        ${current === total - 1 ? 
          `<button class="success" onclick="finishQuiz()">Finalizar Simulado</button>` : 
          `<button onclick="nextQuestion()">Próxima →</button>`
        }
      </div>
    </div>`;
}

function selectOption(i) {
  answers[current] = i;
  renderQuestion();
}

function confirmAnswer() {
  const q = Q[current];
  const userAnswer = answers[current];
  const isCorrect = userAnswer === q.a;

  const options = document.querySelectorAll('.options li');
  options.forEach((li, i) => {
    li.classList.remove('selected');
    if (i === q.a) li.classList.add('correct');
    if (i === userAnswer && !isCorrect) li.classList.add('wrong');
  });

  const feedbackDiv = document.createElement('div');
  feedbackDiv.className = `feedback show ${isCorrect ? 'ok' : 'no'}`;
  feedbackDiv.innerHTML = `<strong>${isCorrect ? '✓ Resposta correta!' : '✗ Resposta incorreta.'}</strong><br>${q.e}`;
  document.querySelector('.question-card').appendChild(feedbackDiv);
  document.querySelector('button[onclick="confirmAnswer()"]').disabled = true;
}

function nextQuestion() { if (current < Q.length - 1) { current++; renderQuestion(); } }
function prevQuestion() { if (current > 0) { current--; renderQuestion(); } }

function finishQuiz() {
  const total = Q.length;
  const correct = answers.filter((a, i) => a === Q[i].a).length;
  const percentage = Math.round((correct / total) * 100);

  let reviewHtml = '';
  Q.forEach((q, i) => {
    const userAns = answers[i];
    const isCorrect = userAns === q.a;
    const userLetter = userAns !== null ? String.fromCharCode(65 + userAns) : 'Não respondida';
    const correctLetter = String.fromCharCode(65 + q.a);
    reviewHtml += `<div class="review-item ${isCorrect ? 'ok' : 'no'}">
      <strong>Questão ${i + 1}:</strong> ${isCorrect ? '✓ Correta' : '✗ Incorreta'}<br>
      <small>Sua resposta: ${userLetter} | Correta: ${correctLetter}</small>
    </div>`;
  });

  let message = '';
  if (percentage >= 80) message = '🎉 Excelente! Você está muito bem preparado(a)!';
  else if (percentage >= 60) message = '👍 Bom desempenho! Continue estudando!';
  else if (percentage >= 40) message = '📚 Razoável. Revise os conteúdos e pratique mais!';
  else message = '💪 Não desanime! Revise os conteúdos e continue praticando!';

  document.getElementById('main').innerHTML = `
    <div class="result-screen">
      <h2>Resultado Final</h2>
      <div class="score-big">${correct}/${total}</div>
      <div class="score-bar"><div class="score-fill" style="width: ${percentage}%"></div></div>
      <p style="font-size: 1.1rem; margin-bottom: 10px;"><strong>${percentage}% de acertos</strong></p>
      <p style="color: #555; margin-bottom: 20px;">${message}</p>
      <div class="review-list">
        <h3 style="margin-bottom: 12px; color: #0d2a52;">Revisão das Questões:</h3>
        ${reviewHtml}
      </div>
      <button class="success" onclick="startQuiz()" style="margin-right:10px;">Refazer Simulado</button>
      <button class="secondary" onclick="renderStart()">Voltar ao Início</button>
    </div>`;
  document.getElementById('progressBar').style.width = '100%';
  document.getElementById('infoLeft').textContent = 'Simulado finalizado';
  document.getElementById('infoRight').textContent = `${correct} acertos de ${total}`;
}

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('service-worker.js').catch(console.error);
  });
}

init();
</script>
