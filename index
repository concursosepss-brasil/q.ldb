  footer { text-align: center; padding: 14px; background: #f4f7fb; font-size: .8rem; color: #666; }
  .gate-screen { text-align: center; padding: 30px 10px; }
  .gate-screen h2 { color: #0d2a52; margin-bottom: 14px; font-size: 1.5rem; }
  .gate-screen p { color: #555; line-height: 1.6; margin-bottom: 18px; max-width: 460px; margin-left: auto; margin-right: auto; }
  .form-field { max-width: 380px; margin: 0 auto 16px; text-align: left; }
  .form-field label { display: block; font-size: .85rem; color: #444; margin-bottom: 6px; font-weight: 600; }
  .form-field input {
    width: 100%; padding: 12px 14px; border: 2px solid #e1e6ef; border-radius: 8px;
    font-size: 1rem; transition: border-color .2s;
  }
  .form-field input:focus { outline: none; border-color: #2a5298; }
