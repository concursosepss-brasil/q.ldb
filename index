  .start-screen, .result-screen { text-align: center; padding: 20px 10px; }
  .start-screen h2 { color: #0d2a52; margin-bottom: 16px; font-size: 1.6rem; }
  .start-screen p { margin-bottom: 14px; color: #555; line-height: 1.6; }
  .start-screen ul { text-align: left; max-width: 500px; margin: 18px auto; color: #444; }
