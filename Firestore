rules_version = '2';

// Este projeto Firebase atende TRÊS apps, cada um com sua própria coleção
// de solicitações de acesso (e portanto listas de aprovados totalmente separadas):
//   - "solicitacoes"      -> Simulado Área da Educação
//   - "solicitacoes_eca"  -> Simulado ECA (Estatuto da Criança e do Adolescente)
//   - "solicitacoes_ldb"  -> Simulado LDB (Lei de Diretrizes e Bases da Educação Nacional)
//
// Em todas, a regra é a mesma: qualquer pessoa pode CRIAR seu próprio pedido de
// acesso (status inicial obrigatoriamente "pending"), qualquer pessoa pode LER
// (só para saber o próprio status), mas só um administrador AUTENTICADO no
// Firebase Auth pode ATUALIZAR (aprovar/recusar) ou APAGAR (revogar) um pedido.

service cloud.firestore {
  match /databases/{database}/documents {

    match /solicitacoes/{emailId} {
      allow read: if true;

      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.lower() == emailId
                    && request.resource.data.keys().hasOnly(['email', 'status', 'criadoEm']);

      allow update, delete: if request.auth != null;
    }

    match /solicitacoes_eca/{emailId} {
      allow read: if true;

      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.lower() == emailId
                    && request.resource.data.keys().hasOnly(['email', 'status', 'criadoEm']);

      allow update, delete: if request.auth != null;
    }

    match /solicitacoes_ldb/{emailId} {
      allow read: if true;

      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.lower() == emailId
                    && request.resource.data.keys().hasOnly(['email', 'status', 'criadoEm']);

      allow update, delete: if request.auth != null;
    }
  }
}
