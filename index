const REQUESTS_COLLECTION = 'solicitacoes_ldb';

/* ===================== ACESSO / CADASTRO POR E-MAIL ===================== */

const STORAGE_USER_EMAIL = 'simulado_userEmail';

function sanitizeEmail(email) { return email.trim().toLowerCase(); }
function isValidEmail(email) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email); }

async function init() {
  const email = localStorage.getItem(STORAGE_USER_EMAIL);
  if (!email) { renderEmailGate(); return; }
  await checkStatus(email);
}

async function checkStatus(email) {
  renderLoading('Verificando seu acesso…');
  try {
    const snap = await db.collection(REQUESTS_COLLECTION).doc(sanitizeEmail(email)).get();
    if (!snap.exists) { renderEmailGate(); return; }
    const data = snap.data();
    if (data.status === 'approved') renderStart();
    else if (data.status === 'rejected') renderGateStatus('rejected', email);
    else renderGateStatus('pending', email);
  } catch (e) {
    renderGateError('Não foi possível conectar ao servidor. Verifique sua internet e tente novamente.');
  }
}

function renderLoading(msg) {
  document.getElementById('main').innerHTML = `<div class="gate-screen"><p>${msg}</p></div>`;
}

function renderGateError(msg) {
  document.getElementById('main').innerHTML = `
    <div class="gate-screen">
      <span class="status-badge rejected">Erro de conexão</span>
      <h2>Algo deu errado</h2>
      <p>${msg}</p>
      <button onclick="init()">Tentar novamente</button>
    </div>`;
}

function renderEmailGate() {
  document.getElementById('main').innerHTML = `
    <div class="gate-screen">
      <h2>Cadastro de acesso</h2>
      <p>Informe seu e-mail para solicitar acesso ao simulado. Um administrador precisa aprovar seu cadastro antes que você possa começar.</p>
      <div class="form-field">
        <label for="emailInput">E-mail</label>
        <input type="email" id="emailInput" placeholder="seuemail@exemplo.com" autocomplete="email">
      </div>
      <div class="error-msg" id="emailError">Informe um e-mail válido.</div>
      <button class="success" onclick="submitEmailRequest()" style="padding:14px 32px; font-size:1.05rem;">Solicitar acesso</button>
    </div>`;
  document.getElementById('progressBar').style.width = '0%';
  document.getElementById('infoLeft').textContent = 'Cadastro necessário';
  document.getElementById('infoRight').textContent = '58 questões';
}

async function submitEmailRequest() {
  const input = document.getElementById('emailInput');
  const email = sanitizeEmail(input.value);
  const errorEl = document.getElementById('emailError');

  if (!isValidEmail(email)) {
    errorEl.classList.add('show');
    return;
  }
  errorEl.classList.remove('show');
  localStorage.setItem(STORAGE_USER_EMAIL, email);

  renderLoading('Enviando solicitação…');
  try {
    const docRef = db.collection(REQUESTS_COLLECTION).doc(email);
    const snap = await docRef.get();
    if (!snap.exists) {
      await docRef.set({
        email,
        status: 'pending',
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
    }
    await checkStatus(email);
  } catch (e) {
    renderGateError('Não foi possível enviar sua solicitação. Tente novamente em instantes.');
  }
}

function renderGateStatus(status, email) {
  let badge = '', title = '', text = '', extraBtn = '';
  if (status === 'pending') {
    badge = '<span class="status-badge pending">Aguardando aprovação</span>';
    title = 'Solicitação enviada';
    text = `O e-mail <strong>${email}</strong> foi registrado e está aguardando a aprovação do administrador. Volte a esta página mais tarde para verificar se o acesso já foi liberado.`;
    extraBtn = `<button class="secondary" onclick="checkAccessAgain()">Verificar novamente</button>`;
  } else {
    badge = '<span class="status-badge rejected">Acesso não liberado</span>';
    title = 'Solicitação recusada';
    text = `O acesso para <strong>${email}</strong> não foi liberado pelo administrador. Você pode tentar com outro e-mail.`;
    extraBtn = `<button class="secondary" onclick="useAnotherEmail()">Usar outro e-mail</button>`;
  }
  document.getElementById('main').innerHTML = `
    <div class="gate-screen">
      ${badge}
      <h2>${title}</h2>
      <p>${text}</p>
      ${extraBtn}
    </div>`;
  document.getElementById('progressBar').style.width = '0%';
  document.getElementById('infoLeft').textContent = 'Aguardando liberação';
  document.getElementById('infoRight').textContent = '58 questões';
}

function checkAccessAgain() { init(); }

function useAnotherEmail() {
  localStorage.removeItem(STORAGE_USER_EMAIL);
  renderEmailGate();
}

